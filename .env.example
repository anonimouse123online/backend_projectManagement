# ═══════════════════════════════════════════════════════════════
# SitePulse Backend — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=updated_sitepulse
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Inbound reverse proxies: leave blank for direct connections.
# Set ONLY after verifying the proxy chain and forwarded-header handling.
# Comma-separated explicit IPs/CIDRs; no true, hop counts, or /0 subnets.
TRUSTED_PROXY_CIDRS=

# CORS — Frontend URL
CORS_ORIGIN=http://localhost:5173

# AI Service
AI_SERVICE_URL=http://localhost:8000
